    <!-- No <parent> before this change: this file manually re-implemented Boot 3.5.16's own
         dependencyManagement piece by piece (spring-framework-bom, jackson-bom, log4j-bom,
         netty-bom imports, each pinned via a property tracking Boot's own value by hand) since
         it had no Boot parent to inherit it from. platform-bom (parent below,
         itself parented on spring-boot-starter-parent:3.5.16) now supplies all of that
         transitively, so the manual re-implementation is removed - repo-wide dependency audit.
         Packaging stays plain jar (maven-assembly-plugin builds the fat jar, not
         spring-boot-maven-plugin), so inheriting Boot's parent adds no repackaging behavior. -->
    <parent>
		<groupId>com.vassarlabs</groupId>
		<artifactId>platform-bom</artifactId>
		<version>2.0.0</version>
		<relativePath/>
	</parent>

	<groupId>com.vassarlabs.iwm</groupId>
	<artifactId>backendApp</artifactId>
	<version>0.0.1-SNAPSHOT</version>

    <properties>
		<java.version>21</java.version>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<javac.target>21</javac.target>
		<javac.source>21</javac.source>
		<!-- Vassarlabs -->
		<vassarlabs.version>0.0.1-SNAPSHOT</vassarlabs.version>

        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

	<dependencyManagement>
		<dependencies>
			<!-- Duplicate APIs pulled in transitively by several internal (wrims-core-*/platform-*) and third-party
			     modules. Managed as 'provided' so they never reach the runtime classpath or packaged jar;
			     the listed replacement provides the same classes. Versions kept explicit (matching the
			     BOM's own pins) because this is a scope override, not a version pin. -->
			<dependency> <!-- superseded by jakarta.xml.bind:jakarta.xml.bind-api 2.3.3 -->
				<groupId>javax.xml.bind</groupId>
				<artifactId>jaxb-api</artifactId>
				<version>2.3.1</version>
				<scope>provided</scope>
			</dependency>
			<dependency> <!-- superseded by com.sun.activation:jakarta.activation -->
				<groupId>javax.activation</groupId>
				<artifactId>javax.activation-api</artifactId>
				<version>1.2.0</version>
				<scope>provided</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- any other plugins -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- Need vendor names to be specified, for the working some libraries 
						(eg., javax jai) -->
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
							<addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
						</manifest>
						<manifestEntries>
							<Specification-Vendor>vassarlabs</Specification-Vendor>
							<Implementation-Vendor>vassarlabs</Implementation-Vendor>
						</manifestEntries>
					</archive>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-archetype-plugin</artifactId>
				<version>3.2.0</version>
			</plugin>
		</plugins>
	</build>
	
