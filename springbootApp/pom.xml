    <properties>
		<java.version>21</java.version>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<javac.target>21</javac.target>
		<javac.source>21</javac.source>
		<!-- Vassarlabs -->
		<vassarlabs.version>0.0.1-SNAPSHOT</vassarlabs.version>

        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <!-- Everything previously here (azure-core-http-netty, google-auth-library-oauth2-http,
         joda-time, apache-kafka/storm/flink.version, lombok.version, junit.version) now comes
         from the platform-bom BOM via <parent> above - repo-wide dependency audit.
         geotools.version (was 28.2, disagreeing with gt-geojson/gt-geojson-core below which were
         already hardcoded to 29.2 - two different GeoTools releases mixed in one module) removed
         the same way; the BOM manages all of it at 29.2. kafka_2.11:2.3.1 removed outright - no
         source in this repo references it (confirmed before removing), a Boot-2.2-era leftover. -->
    <dependencyManagement>
        <dependencies>
			<!-- Duplicate APIs pulled in transitively by several internal (wrims-core-*/platform-*) and third-party
			     modules. Managed as 'provided' so they never reach the runtime classpath or packaged jar;
			     the listed replacement provides the same classes. Versions kept explicit (matching the
			     BOM's own pins) because this is a scope override, not a version pin - dropping the
			     version here to rely purely on the BOM was not verified safe for a scope-only
			     dependencyManagement entry, so left as-is. -->
			<dependency> <!-- superseded by jakarta.xml.bind:jakarta.xml.bind-api 2.3.3 -->
				<groupId>javax.xml.bind</groupId>
				<artifactId>jaxb-api</artifactId>
				<version>2.3.1</version>
				<scope>provided</scope>
			</dependency>
			<dependency> <!-- superseded by com.sun.activation:jakarta.activation -->
				<groupId>javax.activation</groupId>
				<artifactId>javax.activation-api</artifactId>
				<version>1.2.0</version>
				<scope>provided</scope>
			</dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
	        <groupId>org.apache.maven.plugins</groupId>
	        <artifactId>maven-compiler-plugin</artifactId>
	        <configuration>
                <release>21</release>
<!--	          <source>1.8</source>-->
<!--	          <target>1.8</target>-->
	        </configuration>
      	    </plugin> 

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.vassarlabs.application.ApplicationRun</mainClass>
                        </manifest>
                    </archive>
                    <!-- Boot repackaging bundles 'provided' jars too; keep the duplicate APIs managed as
                         'provided' in <dependencyManagement> out of BOOT-INF/lib -->
                    <excludes>
                        <exclude>
                            <groupId>javax.xml.bind</groupId>
                            <artifactId>jaxb-api</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>javax.activation</groupId>
                            <artifactId>javax.activation-api</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

