    <!-- spring-boot-starter-parent -> platform-bom: same reasoning as
         wrims-core-platform's root pom.xml. Must be consumed as <parent>, not import-scope - see
         that BOM's README.md/pom.xml top comment. Its own <parent> is
         spring-boot-starter-parent:3.5.16, so Boot's plugin management still comes through. -->
    <parent>
		<groupId>com.vassarlabs</groupId>
		<artifactId>platform-bom</artifactId>
		<version>2.0.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
    <modelVersion>4.0.0</modelVersion>

